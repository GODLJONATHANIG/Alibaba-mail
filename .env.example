# ==============================================================================
# ALIBABA CLOUD DIRECTMAIL AUTOMATION AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# SECURITY NOTICE:
# - Do NOT commit real credentials to source control.
# - AccessKey Secrets must remain strictly server-side only.
# ==============================================================================

# Singapore Region (ap-southeast-1)
# DirectMail Endpoint: dm.ap-southeast-1.aliyuncs.com
ALIBABA_SG_ACCESS_KEY_ID=
ALIBABA_SG_ACCESS_KEY_SECRET=

# Germany / Frankfurt Region (eu-central-1)
# DirectMail Endpoint: dm.eu-central-1.aliyuncs.com
ALIBABA_GERMANY_ACCESS_KEY_ID=
ALIBABA_GERMANY_ACCESS_KEY_SECRET=

# United States Region (us-east-1 / Virginia)
# DirectMail Endpoint: dm.us-east-1.aliyuncs.com
ALIBABA_US_ACCESS_KEY_ID=
ALIBABA_US_ACCESS_KEY_SECRET=

# Operational Mode
# Set to 'true' to run offline sandbox test simulations without contacting live Alibaba APIs
# Set to 'false' for live production sending with valid Alibaba Cloud DirectMail credentials
TEST_MODE=true

# System Preferences
DEFAULT_TIMEZONE=Asia/Kolkata
RATE_LIMIT_QPS=5.0
MAX_RETRIES=3

# Web Server Configuration
HOST=127.0.0.1
PORT=8000
